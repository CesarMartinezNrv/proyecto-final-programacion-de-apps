#!/bin/sh
set -eu
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "main solo recibe cambios por pull request. Sube una rama codex/*." >&2
    exit 1
  fi
done
if command -v pwsh >/dev/null 2>&1; then
  exec pwsh -NoProfile -File scripts/check.ps1
else
  echo "Instala PowerShell 7 (pwsh) para comprobar el proyecto antes del push." >&2
  exit 1
fi
